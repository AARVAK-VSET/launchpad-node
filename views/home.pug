  meta(property='og:title', content='Launchpad Node')
  meta(property='og:description', content='Production-ready full-stack Node.js web application boilerplate by AARVAK-VSET.')
  meta(property='og:type', content='website')
  meta(property='og:url', content=siteURL)
  meta(property='og:image', content=`${siteURL}/bootstrap-logo.svg`)

  //- Twitter Card tags
  meta(name='twitter:card', content='summary_large_image')
  meta(name='twitter:title', content='Launchpad Node')
  meta(name='twitter:description', content='Production-ready full-stack Node.js web application boilerplate by AARVAK-VSET.')
  meta(name='twitter:image', content=`${siteURL}/bootstrap-logo.svg`)

